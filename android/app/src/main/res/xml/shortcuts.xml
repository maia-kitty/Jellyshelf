<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon → Change server. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="change_server"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/change_server">
        <intent
            android:action="io.github.maiakitty.jellyshelf.CHANGE_SERVER"
            android:targetPackage="io.github.maiakitty.jellyshelf"
            android:targetClass="io.github.maiakitty.jellyshelf.MainActivity" />
    </shortcut>
</shortcuts>
